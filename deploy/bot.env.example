# Copy to /etc/agy-telegram/bot.env (chmod 0600) — NEVER commit real values.

# Telegram Bot Credentials
BOT_TOKEN=123456789:REPLACE_WITH_REAL_BOT_TOKEN
OWNER_ID=1000000001
ALLOWED_IDS=1000000001

# Paths
STATE_DIR=/var/lib/agy-telegram
AGY_WORKSPACE=/root/agy-workspace
MCP_CONFIG_PATH=/root/.gemini/config/mcp_config.json

# Transport & WebApp (polling | webhook | auto)
TG_TRANSPORT=polling
WEBAPP_BASE_URL=https://example.sslip.io
WEBHOOK_URL=https://example.sslip.io/tg/webhook
WEBHOOK_SECRET=REPLACE_WITH_RANDOM_HEX_SECRET

# MCP Gateway
MCP_GW_PORT=8788
MCP_GW_ENABLED=false

# Proxy & Account Safety
PROXY_MODE=failover
PROXY_URLS=direct
ACCT_POLICY_PRESET=strict_safe
ACCT_WEEKLY_RESERVE_PCT=1.0
ACCT_PROXY_FALLBACK=fail_closed

# Guardrails & Hygiene
OUTBOX_SECRET_SCAN=true
AGY_DYNAMIC_PROFILE=true
LOCAL_FAST_PATH=true
CRON_ENABLED=1

# Optional Uncensored / OpenAI-compatible Endpoint
# VENICE_API_BASE=https://api.example.com/v1
# VENICE_API_KEY=REPLACE_WITH_API_KEY
